# A real contact email is required by the SEC's fair-access guidance.
SEC_USER_AGENT="DS3 Credit Memo your-email@example.com"

# Optional. Without this, the app creates source-backed draft observations for manual editing.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-astra"

# Optional. Keep IBISWorld credentials local; its content is never sent to OpenAI.
IBISWORLD_CLIENT_ID=""
IBISWORLD_USERNAME=""
IBISWORLD_PASSWORD=""
# Set only after confirming your account permits API retrieval and local display.
IBISWORLD_LICENSE_CONFIRMED="false"
